# Theme: entune_audio_ext_font
# Version 1.0
# Last Update: 05/29/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# Description: Theme based on the Entune Audio media system. The font used is the YuGothic font by JIYUKOBO. **THIS IS WHY THE FILE SIZE IS SO BIG** The font supports kanji, kana, mandarin and many other languages (see full list in config file). All pixel art is by me. All icons are made by me and/or updated from my previous themes. (minimal_RTC_sync and bunnyPod).
# Code based on: minimal_RTC_sync and bunnyPod which were based on SNARTY by Simon Anden and BONES by Chuck Largo!

# SBS File

# Disable Status Bar
%wd

# Disable Title
%?Lt<|>

# Preload Fonts
%Fl(3,16-YuGothB.fnt)
%Fl(4,20-YuGothM.fnt)

#Preload Images
%xl(music_note,music_note.bmp,0,0)
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(repeat,repeat_status.bmp,0,0,5)
%xl(shuffle,shuffle.bmp,0,0,2)
%xl(battery,battery.bmp,0,0,12)
%xl(disk,disk.bmp,0,0,5)
%xl(lock,lock.bmp,0,0,2)
%xl(usb,usb.bmp,0,0)

# Display Viewports
%?if(%cs, =, 21)<%VI(clearScreen)%Vd(usbScreen)%Vd(border)|%Vd(mainMenu)<%VI(mainMenu)%Vd(mainMenu)%Vd(border)>>

# Clear Screen
%Vi(clearScreen,0,0,1,1,-)

## Main Menu ##

# Main Menu UI Viewport
%Vi(mainMenu,10,60,300,160,4)

# Line
%Vl(mainMenu,5,30,310,2,-)
%dr(0,0,310,2)

# Play/Pause Icons
%Vl(mainMenu,10,6,50,18,-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)|%xd(playmodes,1)>

# Shuffle Icon
%Vl(mainMenu,61,6,50,18,-)
%?if(%mp, >, 1)<%?ps<%xd(shuffle,1)|%xd(shuffle,2)>|%xd(shuffle,2)>>

# Repeat Icon
%Vl(mainMenu,112,6,50,18,-)
%?if(%mp, >, 1)<%?mm<%xd(repeat,5)|%xd(repeat,1)|%xd(repeat,2)|%xd(repeat,3)|%xd(repeat,4)>|%xd(repeat,5)>

# Hold Icon
%Vl(mainMenu,265,6,50,18,-)
%?mh<%xd(lock,1)|%xd(lock,2)>

# Battery Icon
%Vl(mainMenu,235,6,22,18,-)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Time
%Vl(mainMenu,220,35,95,20,4)
%ar%?cf<%cH|%cl>:%cM %?cf<| %cP >%Vs(invert)

# Date
%Vl(mainMenu,5,35,220,20,4)
%al %?cu<Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday>, %cb %cd%Vs(invert)

# Disk
%Vl(mainMenu,216,7,16,16,-)
%?lh<%t(0.1)%xd(disk,5);%t(0.1)%xd(disk,1);%t(0.1)%xd(disk,2);%t(0.1)%xd(disk,3);%t(0.1)%xd(disk,4)|%xd(disk,5)>

# Mini Album Art
%Vl(mainMenu,10,220,16,16,-)
%Cl(1,1,14,14,c,c)
%?if(%mp, >, 1)<%?C<%Cd|%xd(music_note)>>
%?if(%mp, >, 1)<%?C<%dr(0,0,16,1)>>
%?if(%mp, >, 1)<%?C<%dr(0,15,16,1)>>
%?if(%mp, >, 1)<%?C<%dr(0,1,1,14)>>
%?if(%mp, >, 1)<%?C<%dr(15,1,1,14)>>

# Now Playing
%Vl(mainMenu,30,221,285,16,3)
%?if(%mp, >, 1)<%al%s%?it<%it|%fn>%?ia< - %ia>>

## Quick Screen ##

# Clear Screen
%?if(%cs, =, 10)<%Vd(QuickScreen)%VI(QuickScreen)>

# Quick Screen Viewport
%Vi(QuickScreen,10,60,300,160,3)

## USB Screen ##

# USB Screen Viewport
%Vl(usbScreen,0,0,320,240,-)

# Time
%Vl(usbScreen,5,6,240,20,4)
%al%?cf<%cH|%cl>:%cM%?cf<| %cP>

# Battery Icon
%Vl(usbScreen,288,6,22,18,-)
%?bp<%xd(battery,7)|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>%?bp<%?bc<%?bl<%xd(battery,12)|%xd(battery,11)|%xd(battery,10)|%xd(battery,9)|%xd(battery,8)|%xd(battery,7)>|%?bl<%xd(battery,6)|%xd(battery,5)|%xd(battery,4)|%xd(battery,3)|%xd(battery,2)|%xd(battery,1)>>>

# Line
%Vl(usbScreen,5,30,310,2,-)
%dr(0,0,310,2)

# USB Text
%Vl(usbScreen,60,45,200,20,4)
%acUSB CONNECTED%Vs(invert)

# Eject Warning
%Vl(usbScreen,60,75,200,18,3)
%ac%t(1)! EJECT BEFORE DISCONNECTING !;%t(.1)%ac

# Battery (numerical)
%Vl(usbScreen,225,6,50,20,4)
%ar%bl%%

# USB Image
%Vl(usbScreen,65,110,190,116,-)
%xd(usb)